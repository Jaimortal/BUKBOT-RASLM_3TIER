# Environment Configuration for BukSU Chatbot
# Copy this file to .env and update values for your environment

# Application Environment
NODE_ENV=development
# Options: development, staging, production

# Server Configuration
PORT=5000
HOST=127.0.0.1

# Rasa Configuration
RASA_MODEL_PATH=models/
RASA_NLU_DATA=data/
RASA_DOMAIN_DATA=domain.yml
RASA_CONFIG_DATA=config.yml
RASA_ENDPOINT=http://localhost:5005/webhooks/rest/webhook
# Node server -> Rasa API (not the public URL). On separate hosts, use a private URL.
RASA_BASE_URL=http://127.0.0.1:5005

# Database Configuration (PostgreSQL)
# These values are examples; override them in your local .env
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=buksu_chatbot

# Alternative database URLs (optional)
# DATABASE_URL=postgresql://username:password@localhost:5432/buksu_chatbot
# DATABASE_URL=mongodb://localhost:27017/buksu_chatbot

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
API_KEY=your-api-key-for-external-services

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log

# External Services
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# FACEBOOK_PAGE_TOKEN=your-facebook-page-token

# Optional guarded LLM reranker & intent matcher
# The LLM only chooses from official JSON-backed candidates. It does not write
# the final BukSU answer. Keep disabled until you are ready to test with API keys.
RASA_LLM_RERANKER_ENABLED=false
# Options: groq, gemini
RASA_LLM_PROVIDER=groq
# Automatic backup provider when the primary provider is rate-limited or unavailable.
RASA_LLM_FALLBACK_PROVIDER=gemini
RASA_LLM_TIMEOUT_SECONDS=3.5
RASA_LLM_TOP_K=5
RASA_LLM_MAX_PROMPT_CHARS=7000
RASA_LLM_MAX_TOKENS=160

# ==============================================================================
# Groq API Keys Pool (3 Keys with Automatic Failover Rotation)
# ==============================================================================
GROQ_API_KEY_1=your-first-groq-api-key-here
GROQ_API_KEY_2=your-second-groq-api-key-here
GROQ_API_KEY_3=your-third-groq-api-key-here
# Single key backwards compatibility:
# GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# ==============================================================================
# Google AI Studio (Gemini) API Keys Pool (3 Keys Backup Pool)
# ==============================================================================
GEMINI_API_KEY_1=your-first-gemini-api-key-here
GEMINI_API_KEY_2=your-second-gemini-api-key-here
GEMINI_API_KEY_3=your-third-gemini-api-key-here
# Single key backwards compatibility:
# GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# File Upload Limits
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379

# Monitoring
ENABLE_MONITORING=true
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CHAT_HISTORY=true
ENABLE_MAP_INTEGRATION=true
